@model Contact

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">İletişim Düzenle</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <form method="post">
                            <input type="hidden" asp-for="ContactId" />

                            <div class="form-group">
                                <label>Başlık</label>
                                <input type="text" class="form-control" asp-for="Title" />
                            </div>
                            <div class="form-group">
                                <label>Açıklama</label>
                                <input type="text" class="form-control" asp-for="Description" />
                            </div>
                            <div class="form-group">
                                <label>Tel:</label>
                                <input type="text" class="form-control" asp-for="Phone1" />
                            </div>
                            <div class="form-group">
                                <label>Tel:</label>
                                <input type="text" class="form-control" asp-for="Phone2" />
                            </div>
                            <div class="form-group">
                                <label>Email:</label>
                                <input type="text" class="form-control" asp-for="Email1" />
                            </div>
                            <div class="form-group">
                                <label>Email</label>
                                <input type="text" class="form-control" asp-for="Email2" />
                            </div>
                            <div class="form-group">
                                <label>Adres:</label>
                                <input type="text" class="form-control" asp-for="Adress" />
                            </div>

                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



